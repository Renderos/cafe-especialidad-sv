# Copia este archivo como .env.local y completa los valores.
# Supabase Dashboard → Project Settings → API (o "Connect").

# URL del proyecto, p. ej. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave pública "anon" (o la nueva "publishable", sb_publishable_...).
# Es segura junto con RLS, pero aquí solo se usa en el servidor.
SUPABASE_ANON_KEY=
